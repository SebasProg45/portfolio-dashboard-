# Copia este archivo a .env.local y completa los valores.
# .env.local NUNCA se commitea (ya está en .gitignore).

# Personal Access Token de GitHub (fine-grained o classic).
# Scopes necesarios: "read:user" y "public_repo" (o "repo" si quieres incluir privados).
# Crear uno en: https://github.com/settings/tokens
GITHUB_TOKEN=

# Tu usuario de GitHub (el que se va a analizar en el dashboard).
GITHUB_USERNAME=sebastianGonzalez34

# Connection string de Postgres (Neon, vía Vercel Marketplace o directamente
# en neon.tech). Se usa para guardar snapshots históricos de tu actividad.
DATABASE_URL=

# Secreto compartido para proteger /api/cron/snapshot. Genera cualquier
# string aleatorio largo y ponlo también como env var en Vercel: Vercel
# agrega automáticamente "Authorization: Bearer <CRON_SECRET>" a las
# llamadas que dispara el cron configurado en vercel.json.
CRON_SECRET=
